PORT=3000
DATABASE_URL=postgres://appuser:apppass@db:5432/appdb
PUBLIC_APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
REDIS_URL=redis://redis:6379
OAUTH_ISSUER_URL=https://accounts.google.com
OAUTH_ALLOWED_ISSUERS=https://accounts.google.com,accounts.google.com
OAUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
OAUTH_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
OAUTH_DEFAULT_ROLE=moderator
OAUTH_USE_ID_TOKEN_FOR_API=true
